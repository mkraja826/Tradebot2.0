[Unit]
Description=Recover Trading read-only preview dashboard
After=network.target

[Service]
Type=simple
User=recovertrading
Group=recovertrading
WorkingDirectory=/opt/recover-trading/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m recover_trading.dashboard --data-dir /var/lib/recover-trading/preview --port 18766
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
