[Unit]
Description=Recover Trading paired forward reference research
[Service]
Type=oneshot
User=recovertrading
WorkingDirectory=/opt/recover-trading/current
ExecStart=/usr/bin/python3 -m recover_trading.paired_forward --data-dir /var/lib/recover-trading/demo
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=90
