[Unit]
Description=Tradebot 2.0 signed isolated DEMO monitor %i
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=support
Group=support
Environment=HOME=/home/support
WorkingDirectory=/home/support/Tradebot2.0
ExecStart=/usr/bin/bash /home/support/Tradebot2.0/ops/run_isolated_demo_monitor.sh %i
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradebot2-isolated-demo-monitor

[Install]
WantedBy=multi-user.target
