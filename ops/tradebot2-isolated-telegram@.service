[Unit]
Description=Tradebot 2.0 Delta India DEMO isolated %i Telegram safety relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=support
Group=support
Environment=HOME=/home/support
WorkingDirectory=/home/support/Tradebot2.0
ExecStart=/usr/bin/bash /home/support/Tradebot2.0/ops/run_isolated_demo_telegram.sh %i
Restart=always
RestartSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradebot2-isolated-telegram

[Install]
WantedBy=multi-user.target
