[Unit]
Description=Tradebot 2.0 unattended DeepSeek Gold XAUTUSD isolated Delta India DEMO
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=support
Group=support
Environment=HOME=/home/support
WorkingDirectory=/home/support/Tradebot2.0
ExecStart=/usr/bin/bash /home/support/Tradebot2.0/ops/run_gold_autonomous_demo.sh
Restart=always
RestartSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradebot2-gold-autonomous-demo

[Install]
WantedBy=multi-user.target
