# Staging template only: do not enable until authenticated ingress is implemented.
[Unit]
Description=Recover Trading isolated passkey enrollment
After=network.target

[Service]
Type=simple
User=recover-approval
Group=recover-approval
WorkingDirectory=/opt/recover-approval/admin_mcp
ExecStart=/opt/recover-approval/.venv/bin/python -I /opt/recover-approval/admin_mcp/enrollment_service.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/recover-approval
IPAddressDeny=any
IPAddressAllow=localhost
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
